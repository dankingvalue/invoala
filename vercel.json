{
  "crons": [
    {
      "path": "/api/cron/promo",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recurring",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/fx",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "app/api/invoices/*/pdf/route.ts": {
      "memory": 1536,
      "maxDuration": 60
    },
    "app/api/invoices/*/email/route.ts": {
      "memory": 1536,
      "maxDuration": 60
    },
    "app/api/cron/recurring/route.ts": {
      "memory": 1536,
      "maxDuration": 120
    },
    "app/api/pdf-engine/route.ts": {
      "memory": 1536,
      "maxDuration": 90
    }
  }
}
